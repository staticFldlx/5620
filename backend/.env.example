# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATABASE_PATH=db.sqlite3
# DATABASE_URL=postgresql://user:pass@host:5432/db   # optional, needs `pip install psycopg`

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INTAKE_TEACHER_EMAIL=emily.walker@example.com

# LLM: any OpenAI-compatible /chat/completions endpoint. Run `python manage.py check_llm` after changing these.
LLM_PROVIDER=fake                 # openai | school (alias of openai) | fake (offline scripts, no key needed)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_FAST=                   # intent classification and other low-latency calls (defaults to LLM_MODEL_DEFAULT)
LLM_MODEL_DEFAULT=
LLM_TIMEOUT_SECONDS=30
LLM_CAPABILITIES=tools,json_schema  # use the line check_llm prints; subset of tools,json_schema,embeddings
#
# Example A - Google Gemini (free API key from Google AI Studio; works from anywhere, incl. Google Cloud):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=<your AI Studio key>
#   LLM_MODEL_DEFAULT=<a current Flash model listed in AI Studio, e.g. gemini-2.5-flash>
#
# Example B - ELEC5620 course proxy (connect to the USYD VPN first; not reachable from cloud hosts):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://10.167.60.148:8000/v1
#   LLM_API_KEY=<your personal proxy key>
#   LLM_MODEL_DEFAULT=campus-qwen

RETRIEVAL_BACKEND=none            # none | keyword | vector (only none is implemented)
EMBEDDING_BACKEND=                # vector only: school | local

AGENT_TASK_EXECUTION=inline       # inline | worker
TASK_TIMEOUT_SECONDS=120
TASK_MAX_ATTEMPTS=2
AGENT_CONFIDENCE_THRESHOLD=0.70   # the only confidence threshold in the system

# Agent options
TEACHING_SUPPORT_EXPLAIN_MODE=single        # single | loop (tool loop with fallback to single)
TEACHING_SUPPORT_LOOP_BUDGET_SECONDS=6      # loop mode stops calling the model after this many seconds
