# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATABASE_PATH=db.sqlite3
# DATABASE_URL=postgresql://user:pass@host:5432/db   # optional, needs `pip install psycopg`

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INTAKE_TEACHER_EMAIL=emily.walker@example.com

LLM_PROVIDER=fake                 # school | fake
LLM_BASE_URL=                     # OpenAI-compatible endpoint, e.g. https://llm.example.edu/v1
LLM_API_KEY=
LLM_MODEL_FAST=                   # intent classification and other low-latency calls
LLM_MODEL_DEFAULT=
LLM_TIMEOUT_SECONDS=30
LLM_CAPABILITIES=tools,json_schema  # subset of tools,json_schema,embeddings supported by the endpoint

RETRIEVAL_BACKEND=none            # none | keyword | vector (only none is implemented)
EMBEDDING_BACKEND=                # vector only: school | local

AGENT_TASK_EXECUTION=inline       # inline | worker
TASK_TIMEOUT_SECONDS=120
TASK_MAX_ATTEMPTS=2
AGENT_CONFIDENCE_THRESHOLD=0.70   # the only confidence threshold in the system
